# Copy this file to .env and fill in real values

# Gemini API key — get one free at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embedding model (runs locally, downloaded on first run ~130 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/campusai

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_MINUTES=1440

# First admin account (created automatically on first startup)
ADMIN_EMAIL=admin@campusai.in
ADMIN_PASSWORD=admin123

# Paths
CHROMA_DIR=./chroma_db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
